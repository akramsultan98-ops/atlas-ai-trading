# ATLAS V2 configuration. Copy to .env and fill in. .env is gitignored and must
# never be committed.
#
# No financial parameter has a default (ADR-006): a missing risk value is a startup
# error, because a default risk parameter is a silent policy nobody chose.

# --- Operational -----------------------------------------------------------------
ATLAS_ENV=development                 # development | testing | production
ATLAS_DATA_DIR=var                    # database, kill-switch state, kline cache
ATLAS_LOG_LEVEL=INFO

# --- Exchange --------------------------------------------------------------------
# testnet | live. Default is testnet. `live` additionally requires ATLAS_ENV=production,
# so a live connection cannot be armed from a development configuration by accident.
ATLAS_EXCHANGE_ENV=testnet
ATLAS_QUOTE_ASSET=USDT

# --- Runtime ---------------------------------------------------------------------
ATLAS_SYMBOLS=BTCUSDT                 # comma-separated
ATLAS_TIMEFRAME=1h
ATLAS_TICK_INTERVAL_SECONDS=900       # 15 minutes
ATLAS_HISTORY_BARS=500

# --- Risk policy (specification section 6). All ATLAS decisions, not from the video.
ATLAS_RISK_PCT=0.01                   # RISK-01 fraction of equity risked per trade
ATLAS_MAX_CONCURRENT=3                # RISK-02 simultaneous open positions
ATLAS_MAX_POSITION_PCT=0.3333         # RISK-03 cap on one position vs equity
ATLAS_MAX_DEPLOYED_PCT=0.75           # RISK-04 cap on total deployed capital
ATLAS_DAILY_LOSS_LIMIT=0.05           # RISK-05 arms the kill switch
ATLAS_MAX_ACCOUNT_DD=0.20             # RISK-06 arms the kill switch
#
# Fees and slippage are not environment variables: they are part of the backtest cost
# model (BT-04, atlas/backtest/costs.py) and must match what the exchange actually
# charges. Confirm the live fee tier before any cutover.

# --- Credentials: EXECUTION PROCESS ONLY -----------------------------------------
# The research plane never receives these (AI-01). Create the key with SPOT TRADING
# ONLY and WITHDRAWALS DISABLED (EXEC-07); IP-allowlist it where the deployment has a
# static address. Leave blank for testnet dry inspection.
# ATLAS_BINANCE_API_KEY=
# ATLAS_BINANCE_API_SECRET=

# --- Monitoring / alerting (outbound only, no inbound control path) --------------
# Absent values disable notification rather than failing startup: a missing token must
# never stop trading or retirement.
# ATLAS_TELEGRAM_BOT_TOKEN=
# ATLAS_TELEGRAM_CHAT_ID=

# --- Research plane (holds no exchange credential) --------------------------------
# ANTHROPIC_API_KEY=
