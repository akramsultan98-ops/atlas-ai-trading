# ATLAS V2 configuration. Copy to .env and fill in.
# NOTE: no financial parameter has a default. All must be set explicitly.

ATLAS_ENV=development
ATLAS_DATA_DIR=var

# --- Risk policy (spec section 6). All ATLAS decisions, not from the source video. ---
ATLAS_RISK_PCT=0.01
ATLAS_MAX_CONCURRENT=3
ATLAS_MAX_POSITION_PCT=0.3333
ATLAS_MAX_DEPLOYED_PCT=0.75
ATLAS_DAILY_LOSS_LIMIT=0.05
ATLAS_MAX_ACCOUNT_DD=0.20

# --- Execution ---
# NEVER set live credentials during development. See docs/SECURITY.md.
ATLAS_EXCHANGE_ENV=testnet
ATLAS_QUOTE_ASSET=USDT

# --- Credentials: execution process ONLY. The research process must never read these. ---
# ATLAS_BINANCE_API_KEY=
# ATLAS_BINANCE_API_SECRET=

# --- Research plane (no exchange credentials here) ---
# ANTHROPIC_API_KEY=
